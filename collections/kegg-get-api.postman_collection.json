          "name": "Retrieve database entries",
          "request": {
            "name": "Retrieve database entries",
            "description": {
              "content": "Retrieve one or more KEGG database entries in their default flat-file format. Up to 10 entries can be retrieved in a single request by separating identifiers with plus signs (e.g., hsa:10458+ece:Z5100).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "get",
                ":dbentries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dbentries",
                  "description": "(Required) One or more KEGG entry identifiers, separated by plus signs. Maximum 10 entries per request. Format: database:id (e.g., hsa:10458, cpd:C01290, path:hsa00010).\n"
                }
              ]
            },
            "header": [
