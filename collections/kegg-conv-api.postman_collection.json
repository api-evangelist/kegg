          "name": "Convert specific entry identifiers",
          "request": {
            "name": "Convert specific entry identifiers",
            "description": {
              "content": "Convert specific KEGG entry identifiers to their equivalents in an external database, or convert external database identifiers to KEGG identifiers. Up to 10 entries per request.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "conv",
                ":target_db",
                ":dbentries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "target_db",
                  "description": "(Required) Target database for conversion (e.g., ncbi-geneid, uniprot, pubchem, chebi, or a KEGG organism code).\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dbentries",
                  "description": "(Required) One or more entry identifiers separated by plus signs. Maximum 10 entries per request.\n"
