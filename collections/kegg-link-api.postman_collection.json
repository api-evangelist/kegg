        {
          "id": "8a5d42b3-385f-407f-a598-56cfe86512f5",
          "name": "Find cross-references for specific entries",
          "request": {
            "name": "Find cross-references for specific entries",
            "description": {
              "content": "Find related entries in a target KEGG database for specific source entries. Returns tab-delimited cross-reference relationships. Up to 10 entries per request. RDF output formats (turtle, n-triple) are also supported via the option parameter.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "link",
                ":target_db",
                ":dbentries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "target_db",
                  "description": "(Required) Target KEGG database"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dbentries",
                  "description": "(Required) One or more source entry identifiers separated by plus signs. Maximum 10 entries per request.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
