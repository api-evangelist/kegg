          "name": "Find cross-references between databases",
          "request": {
            "name": "Find cross-references between databases",
            "description": {
              "content": "Find related entries between two KEGG databases using cross-references. Returns tab-delimited text listing relationships between entries in the source and target databases.\n",
              "type": "text/plain"
            },
            "url": {
