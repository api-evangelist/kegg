          "name": "Search entries by keyword",
          "request": {
            "name": "Search entries by keyword",
            "description": {
              "content": "Search entries in a KEGG database by keyword or query data. Returns tab-delimited text with matching entry identifiers and names. Searchable fields vary by database and may include ENTRY, NAME, SYMBOL, COMPOSITION, and DEFINITION.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "find",
                ":database",
                ":query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "database",
                  "description": "(Required) KEGG database to search. Supported: genes, ligand, compound, glycan, reaction, rclass, enzyme, disease, drug, dgroup, environ, network, variant, ko, genome, pathway, brite, module.\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "query",
                  "description": "(Required) Keyword(s) to search for, URL-encoded"
                }
              ]
