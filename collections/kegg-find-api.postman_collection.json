              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "database",
                  "description": "(Required) Database to search — compound or drug"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "query",
                  "description": "(Required) Molecular formula (e.g., C6H12O6), exact mass range (e.g., 174.05-174.15), or molecular weight range (e.g., 180-180)\n"
