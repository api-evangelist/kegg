          "request": {
            "name": "Search compound or drug entries by molecular property",
            "description": {
              "content": "Search compound or drug database entries by molecular formula, exact mass, or molecular weight. The option parameter specifies the search type. Only applicable to compound and drug databases.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "find",
                ":database",
                ":query",
                ":option"
              ],
              "host": [
