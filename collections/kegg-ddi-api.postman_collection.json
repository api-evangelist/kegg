          "name": "Get adverse drug-drug interactions for a single drug",
          "request": {
            "name": "Get adverse drug-drug interactions for a single drug",
            "description": {
              "content": "Find adverse drug-drug interactions for a single drug entry. Returns tab-delimited text listing interacting drug pairs and severity data. Drug entries can be specified using KEGG drug IDs (D prefix), NDC codes, or YJ codes.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ddi",
                ":dbentry"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dbentry",
                  "description": "(Required) A single KEGG drug identifier. Formats: KEGG drug ID (e.g., D00001), NDC code, or YJ code.\n"
                }
              ]
            },
